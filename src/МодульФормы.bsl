// Модуль формы внешней обработки "Выгрузка XML Авито".
// Каркас формы для 1С ERP 2.5.25.101.
//
// Ожидаемые реквизиты формы:
// - ПутьКТекущемуXML
// - ПапкаРезультата
// - ТипЦен
// - Склады
// - ИсключатьВидыНоменклатуры
// - НеСниматьМенеджеров
// - ОбновлятьЦены
// - ВыгружатьФото
// - МаксимумФото
// - СохранятьСуществующиеФотоXML
//
// Команды формы:
// - СформироватьВыгрузку
// - ПроверитьДанные
// - ОткрытьПапкуРезультата

Процедура ПриОткрытии()

    УстановитьЗначенияПоУмолчанию();

КонецПроцедуры

Процедура СформироватьВыгрузкуКоманда(Команда)

    Параметры = ПолучитьПараметрыФормы();

    Попытка
        Результат = Объект.СформироватьВыгрузкуАвито(Параметры);
        ПоказатьКраткийИтог(Результат);
    Исключение
        Сообщить("Ошибка формирования выгрузки Авито: " + ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры

Процедура ПроверитьДанныеКоманда(Команда)

    Параметры = ПолучитьПараметрыФормы();

    // Проверка выполняет основные шаги без записи итогового XML и ZIP:
    // читает текущий XML, получает остатки/цены, применяет фильтр "спецодежда",
    // сопоставляет объявления и показывает пользователю количество снятых,
    // новых, дублей и строк ручной проверки.
    Попытка
        ДанныеXML = Объект.ПрочитатьТекущийXML(Параметры.ПутьКТекущемуXML);
        Остатки = Объект.ПолучитьОстаткиERP(Параметры);
        ОстаткиПослеФильтра = Объект.ОтфильтроватьОстатки(Остатки, Параметры);
        Цены = Объект.ПолучитьЦеныКинезис(
            Объект.ПолучитьСписокНоменклатуры(ОстаткиПослеФильтра.ОстаткиПослеФильтра),
            Параметры);

        Результат = Объект.СопоставитьXMLИОстатки(
            ДанныеXML.ОбъявленияXML,
            ОстаткиПослеФильтра.ОстаткиПослеФильтра,
            Цены,
            Параметры);

        Результат.Вставить("ИсключеноФильтром", ОстаткиПослеФильтра.ИсключеноФильтром);
        ПоказатьКраткийИтог(Результат);
    Исключение
        Сообщить("Ошибка проверки данных: " + ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры

Процедура ОткрытьПапкуРезультатаКоманда(Команда)

    Если ПустаяСтрока(ПапкаРезультата) Тогда
        Сообщить("Не заполнена папка результата.");
        Возврат;
    КонецЕсли;

    // TODO: проверить в тонком клиенте ERP.
    // Возможный вариант:
    // ЗапуститьПриложение(ПапкаРезультата);
    Сообщить("Папка результата: " + ПапкаРезультата);

КонецПроцедуры

Функция ПолучитьПараметрыФормы()

    Параметры = Объект.СоздатьПараметрыПоУмолчанию();

    Параметры.Вставить("ПутьКТекущемуXML", ПутьКТекущемуXML);
    Параметры.Вставить("ПапкаРезультата", ПапкаРезультата);
    Параметры.Вставить("ИмяИтоговогоXML", "avito_autoload_filtered.xml");
    Параметры.Вставить("ИмяАрхиваФото", "avito_photos.zip");
    Параметры.Вставить("ТипЦен", ТипЦен);
    Параметры.Вставить("Склады", Склады);
    Параметры.Вставить("ИсключатьВидыНоменклатуры", ИсключатьВидыНоменклатуры);
    Параметры.Вставить("НеСниматьМенеджеров", НеСниматьМенеджеров);
    Параметры.Вставить("ОбновлятьЦены", ОбновлятьЦены);
    Параметры.Вставить("ВыгружатьФото", ВыгружатьФото);
    Параметры.Вставить("МаксимумФото", МаксимумФото);
    Параметры.Вставить("СохранятьСуществующиеФотоXML", СохранятьСуществующиеФотоXML);

    Возврат Параметры;

КонецФункции

Процедура УстановитьЗначенияПоУмолчанию()

    Если ПустаяСтрока(ТипЦен) Тогда
        ТипЦен = "Кинезис";
    КонецЕсли;

    Если Склады = Неопределено Тогда
        Склады = Новый Массив;
    КонецЕсли;

    Если Склады.Количество() = 0 Тогда
        Склады.Добавить("Агрегаты восстановленные Реман (Суставов А.)");
        Склады.Добавить("Склад Исток Основной");
        Склады.Добавить("Склад форсунки восстановленные Исток (Суставов А.)");
        Склады.Добавить("Склад деталей REMAN (Суставов А.)");
        Склады.Добавить("Склад форсунки восстановленные Кимры");
        Склады.Добавить("Склад РВД Исток");
    КонецЕсли;

    Если ИсключатьВидыНоменклатуры = Неопределено Тогда
        ИсключатьВидыНоменклатуры = Новый Массив;
    КонецЕсли;

    Если ИсключатьВидыНоменклатуры.Количество() = 0 Тогда
        ИсключатьВидыНоменклатуры.Добавить("спецодежда");
    КонецЕсли;

    Если НеСниматьМенеджеров = Неопределено Тогда
        НеСниматьМенеджеров = Новый Массив;
    КонецЕсли;

    Если НеСниматьМенеджеров.Количество() = 0 Тогда
        НеСниматьМенеджеров.Добавить("Юрий");
    КонецЕсли;

    Если МаксимумФото = 0 Тогда
        МаксимумФото = 10;
    КонецЕсли;

    ОбновлятьЦены = Ложь;
    ВыгружатьФото = Истина;
    СохранятьСуществующиеФотоXML = Истина;

КонецПроцедуры

Процедура ПоказатьКраткийИтог(Результат)

    Если Результат = Неопределено Тогда
        Возврат;
    КонецЕсли;

    Сообщить("Выгрузка Авито подготовлена.");
    Сообщить("Итоговый XML: " + Результат.ПутьИтоговогоXML);
    Сообщить("Архив фото: " + Результат.ПутьАрхиваФото);

    Если Результат.Свойство("КВыгрузке") Тогда
        Сообщить("Оставлено в XML: " + Результат.КВыгрузке.Количество());
    КонецЕсли;

    Если Результат.Свойство("КСнятию") Тогда
        Сообщить("Снять с Авито: " + Результат.КСнятию.Количество());
    КонецЕсли;

    Если Результат.Свойство("НовыеТовары") Тогда
        Сообщить("Новые товары только в отчёте: " + Результат.НовыеТовары.Количество());
    КонецЕсли;

    Если Результат.Свойство("РучнаяПроверка") Тогда
        Сообщить("Ручная проверка: " + Результат.РучнаяПроверка.Количество());
    КонецЕсли;

    Если Результат.Свойство("Ошибки") Тогда
        Сообщить("Ошибки: " + Результат.Ошибки.Количество());
    КонецЕсли;

КонецПроцедуры
