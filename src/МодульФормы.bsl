Функция ПолучитьПараметрыФормы()

    Параметры = Новый Структура;

    Параметры.Вставить("ТипЦен", ТипЦен);
    Параметры.Вставить("Склады", Склады);
    Параметры.Вставить("ПутьКТекущемуXML", ПутьКТекущемуXML);
    Параметры.Вставить("ПутьСохраненияXML", ПутьСохраненияXML);
    Параметры.Вставить("ПапкаСохраненияОтчётов", ПапкаСохраненияОтчётов);
    Параметры.Вставить("БазовыйURLФотографий", БазовыйURLФотографий);
    Параметры.Вставить("ПутьВыгрузкиФотоНаСервер", ПутьВыгрузкиФотоНаСервер);
    Параметры.Вставить("МаксимальноеКоличествоФото", МаксимальноеКоличествоФото);
    Параметры.Вставить("ВыгружатьБезФото", ВыгружатьБезФото);
    Параметры.Вставить("ИспользоватьТекущийXMLКакШаблон", ИспользоватьТекущийXMLКакШаблон);

    Возврат Параметры;

КонецФункции
