Функция ОтфильтроватьОстатки(Остатки, Параметры) Экспорт

    ОстаткиПослеФильтра = Остатки.СкопироватьКолонки();
    ИсключеноФильтром = СоздатьТаблицуИсключеноФильтром();

    Для Каждого Товар Из Остатки Цикл
        Причина = ПричинаИсключенияПоВидуНоменклатуры(Товар.ВидНоменклатуры, Параметры);
        Если ПустаяСтрока(Причина) Тогда
            ЗаполнитьЗначенияСвойств(ОстаткиПослеФильтра.Добавить(), Товар);
        Иначе
            Строка = ИсключеноФильтром.Добавить();
            Строка.Код1С = Товар.Код1С;
            Строка.Артикул = Товар.Артикул;
            Строка.Номенклатура = Товар.Наименование;
            Строка.ВидНоменклатуры = Товар.ВидНоменклатуры;
            Строка.Склад = Товар.Склад;
            Строка.Остаток = Товар.Остаток;
            Строка.ПричинаИсключения = Причина;
        КонецЕсли;
    КонецЦикла;

    Возврат Новый Структура("ОстаткиПослеФильтра,ИсключеноФильтром", ОстаткиПослеФильтра, ИсключеноФильтром);

