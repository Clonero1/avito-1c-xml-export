Функция НормализоватьАртикул(Значение) Экспорт

    Если Значение = Неопределено Тогда
        Возврат "";
    КонецЕсли;

    Результат = ВРег(СокрЛП(Строка(Значение)));
    Результат = УдалитьТекстВКруглыхСкобках(Результат);
    Результат = СтрЗаменить(Результат, "А", "A");
    Результат = СтрЗаменить(Результат, "В", "B");
    Результат = СтрЗаменить(Результат, "Е", "E");
    Результат = СтрЗаменить(Результат, "К", "K");
    Результат = СтрЗаменить(Результат, "М", "M");
    Результат = СтрЗаменить(Результат, "Н", "H");
    Результат = СтрЗаменить(Результат, "О", "O");
    Результат = СтрЗаменить(Результат, "Р", "P");
    Результат = СтрЗаменить(Результат, "С", "C");
    Результат = СтрЗаменить(Результат, "Т", "T");
    Результат = СтрЗаменить(Результат, "Х", "X");
    Результат = СтрЗаменить(Результат, "У", "Y");

    Очищенный = "";
    Для НомерСимвола = 1 По СтрДлина(Результат) Цикл
        Символ = Сред(Результат, НомерСимвола, 1);
        Если (Символ >= "A" И Символ <= "Z") Или (Символ >= "0" И Символ <= "9") Тогда
            Очищенный = Очищенный + Символ;
        КонецЕсли;
    КонецЦикла;

    Возврат Очищенный;

КонецФункции

Функция РазбитьАртикулыНаКлючи(Значение) Экспорт

    Ключи = Новый Массив;
    Если Значение = Неопределено Тогда
        Возврат Ключи;
    КонецЕсли;

    Текст = Строка(Значение);
    Текст = СтрЗаменить(Текст, "/", ",");
    Текст = СтрЗаменить(Текст, ";", ",");

    Части = СтрРазделить(Текст, ",", Ложь);
    Для Каждого Часть Из Части Цикл
        Ключ = НормализоватьАртикул(Часть);
        Если ПустаяСтрока(Ключ) Тогда
            Продолжить;
        КонецЕсли;
        ДобавитьУникальныйКлюч(Ключи, Ключ);
        Если ТолькоЦифры(Ключ) Тогда
            ДобавитьУникальныйКлюч(Ключи, УдалитьВедущиеНули(Ключ));
        КонецЕсли;
        Если Прав(Ключ, 2) = "RN" Тогда
            ДобавитьУникальныйКлюч(Ключи, Лев(Ключ, СтрДлина(Ключ) - 2));
        КонецЕсли;
    КонецЦикла;

    Возврат Ключи;

КонецФункции

Функция ПолучитьКлючиТовара(Артикул, КатНомер2)
    Ключи = РазбитьАртикулыНаКлючи(Артикул);
    Для Каждого Ключ Из РазбитьАртикулыНаКлючи(КатНомер2) Цикл
        ДобавитьУникальныйКлюч(Ключи, Ключ);
    КонецЦикла;
    Возврат Ключи;
КонецФункции

Процедура ДобавитьУникальныйКлюч(Ключи, Ключ)
    Если Не ПустаяСтрока(Ключ) И Ключи.Найти(Ключ) = Неопределено Тогда
        Ключи.Добавить(Ключ);
    КонецЕсли;
КонецПроцедуры

Функция УдалитьТекстВКруглыхСкобках(Текст)
    Пока СтрНайти(Текст, "(") > 0 И СтрНайти(Текст, ")") > СтрНайти(Текст, "(") Цикл
        Начало = СтрНайти(Текст, "(");
        Конец = СтрНайти(Текст, ")");
        Текст = Лев(Текст, Начало - 1) + Сред(Текст, Конец + 1);
    КонецЦикла;
    Возврат Текст;
КонецФункции

Функция ТолькоЦифры(Значение)
    Если ПустаяСтрока(Значение) Тогда
        Возврат Ложь;
    КонецЕсли;
    Для НомерСимвола = 1 По СтрДлина(Значение) Цикл
        Символ = Сред(Значение, НомерСимвола, 1);
        Если Не (Символ >= "0" И Символ <= "9") Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

Функция УдалитьВедущиеНули(Значение)
    Результат = Значение;
    Пока СтрДлина(Результат) > 1 И Лев(Результат, 1) = "0" Цикл
        Результат = Сред(Результат, 2);
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция МенеджерВИсключениях(Менеджер, Параметры)
    Для Каждого ИмяМенеджера Из Параметры.НеСниматьМенеджеров Цикл
        Если НРег(СокрЛП(Менеджер)) = НРег(СокрЛП(ИмяМенеджера)) Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

