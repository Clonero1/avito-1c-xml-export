// Модуль объекта внешней обработки Авито.
// Первый BSL-каркас для переноса проверенной Python-логики в 1С ERP 2.5.
//
// Критические правила:
// - текущий XML Авито используется как шаблон;
// - старые Id, Title, Description, категории и существующий Images не пересобираются;
// - новые товары автоматически в XML не добавляются;
// - менеджер Юрий не снимается автоматически;
// - вид номенклатуры "спецодежда" исключается из остатков;
// - запрещено перезаписывать существующий блок Images из текущего XML.

Функция СоздатьПараметрыПоУмолчанию() Экспорт

    Параметры = Новый Структура;
    Параметры.Вставить("ПутьКТекущемуXML", "");
    Параметры.Вставить("ПапкаРезультата", "");
    Параметры.Вставить("ИмяИтоговогоXML", "avito_autoload_filtered.xml");
    Параметры.Вставить("ИмяАрхиваФото", "avito_photos.zip");
    Параметры.Вставить("ТипЦен", "Кинезис");
    Параметры.Вставить("Склады", Новый Массив);

    ИсключатьВиды = Новый Массив;
    ИсключатьВиды.Добавить("спецодежда");
    Параметры.Вставить("ИсключатьВидыНоменклатуры", ИсключатьВиды);

    НеСниматьМенеджеров = Новый Массив;
    НеСниматьМенеджеров.Добавить("Юрий");
    Параметры.Вставить("НеСниматьМенеджеров", НеСниматьМенеджеров);

    Параметры.Вставить("ОбновлятьЦены", Ложь);
    Параметры.Вставить("ВыгружатьФото", Ложь);
    Параметры.Вставить("МаксимумФото", 10);
    Параметры.Вставить("СохранятьСуществующиеФотоXML", Истина);

    Возврат Параметры;

КонецФункции

Функция СформироватьВыгрузкуАвито(Параметры) Экспорт

    ПроверитьПараметрыВыгрузки(Параметры);

    ДанныеXML = ПрочитатьТекущийXML(Параметры.ПутьКТекущемуXML);
    ОстаткиERP = ПолучитьОстаткиERP(Параметры);
    РезультатФильтра = ОтфильтроватьОстатки(ОстаткиERP, Параметры);
    ОстаткиПослеФильтра = РезультатФильтра.ОстаткиПослеФильтра;
    Цены = ПолучитьЦеныКинезис(ПолучитьСписокНоменклатуры(ОстаткиПослеФильтра), Параметры);

    Результат = СопоставитьXMLИОстатки(ДанныеXML.ОбъявленияXML, ОстаткиПослеФильтра, Цены, Параметры);
    Результат.Вставить("ИсходноеДеревоXML", ДанныеXML.ДеревоXML);
    Результат.Вставить("ИсключеноФильтром", РезультатФильтра.ИсключеноФильтром);

    СформироватьФотоZIP(Результат, Параметры);
    ПутьXML = СформироватьИтоговыйXML(Результат, Параметры);
    СформироватьОтчеты(Результат, Параметры);

    Итог = Новый Структура;
    Итог.Вставить("ПутьИтоговогоXML", ПутьXML);
    Итог.Вставить("ПутьАрхиваФото", Параметры.ПапкаРезультата + "\" + Параметры.ИмяАрхиваФото);
    Итог.Вставить("РезультатСопоставления", Результат);

    Возврат Итог;

КонецФункции

Процедура ПроверитьПараметрыВыгрузки(Параметры)

    Если ПустаяСтрока(Параметры.ПутьКТекущемуXML) Тогда
        ВызватьИсключение "Не указан путь к текущему XML Авито.";
    КонецЕсли;

    Если ПустаяСтрока(Параметры.ПапкаРезультата) Тогда
        ВызватьИсключение "Не указана папка результата.";
    КонецЕсли;

    Если Параметры.Склады.Количество() = 0 Тогда
        ВызватьИсключение "Не выбран список складов для остатков.";
    КонецЕсли;

КонецПроцедуры

