Функция ПричинаИсключенияПоВидуНоменклатуры(ВидНоменклатуры, Параметры)

    ВидНоменклатурыНРег = НРег(Строка(ВидНоменклатуры));
    Для Каждого ИсключаемыйВид Из Параметры.ИсключатьВидыНоменклатуры Цикл
        Если СтрНайти(ВидНоменклатурыНРег, НРег(ИсключаемыйВид)) > 0 Тогда
            Возврат "Вид номенклатуры содержит """ + ИсключаемыйВид + """";
        КонецЕсли;
    КонецЦикла;
    Возврат "";

КонецФункции

Функция СопоставитьXMLИОстатки(ОбъявленияXML, Остатки, Цены, Параметры) Экспорт

    Результат = СоздатьСтруктуруРезультатаСопоставления();
    ИндексОстатковПоКлючам = ПостроитьИндексОстатковПоКлючам(Остатки);
    ИндексXMLПоКлючам = ПостроитьИндексXMLПоКлючам(ОбъявленияXML);
    ЗаполнитьДублиXMLПоOEM(ИндексXMLПоКлючам, Результат.ДублиXMLПоOEM);

    Для Каждого Объявление Из ОбъявленияXML Цикл
        Если Объявление.Ключи.Количество() = 0 Тогда
            ДобавитьВРучнуюПроверку(Результат, Объявление, Неопределено, "В XML не заполнен OEM или не удалось получить ключ сравнения");
            Продолжить;
        КонецЕсли;

        Совпадения = НайтиОстаткиПоКлючам(Объявление.Ключи, ИндексОстатковПоКлючам);
        Если Совпадения.Количество() = 0 Тогда
            Если МенеджерВИсключениях(Объявление.ManagerName, Параметры) Тогда
                ДобавитьКВыгрузке(Результат, Объявление, Неопределено, Неопределено);
                ДобавитьВРучнуюПроверку(Результат, Объявление, Неопределено, "Нет совпадения в остатках 1С, но объявление сохранено: менеджер входит в список исключений");
            Иначе
                ДобавитьКСнятию(Результат, Объявление, "Нет совпадения в остатках 1С");
            КонецЕсли;
            Продолжить;
        КонецЕсли;

        Если Совпадения.Количество() > 1 Тогда
            ДобавитьКВыгрузке(Результат, Объявление, Неопределено, Неопределено);
            ДобавитьВРучнуюПроверку(Результат, Объявление, Совпадения, "Один OEM XML совпал с несколькими товарами 1С");
            Продолжить;
        КонецЕсли;

        Товар = Совпадения[0];
        Цена = Цены.Получить(Товар.Номенклатура);
        Если Параметры.ОбновлятьЦены И Цена = Неопределено Тогда
            ДобавитьВОшибки(Результат, Объявление, Товар, "Не найдена цена по типу цен " + Параметры.ТипЦен);
        КонецЕсли;

        ДобавитьКВыгрузке(Результат, Объявление, Товар, Цена);
        ДобавитьВСопоставленные(Результат, Объявление, Товар, Цена);
    КонецЦикла;

    ЗаполнитьНовыеТовары(Остатки, ИндексXMLПоКлючам, Результат.НовыеТовары);
    Возврат Результат;

КонецФункции

