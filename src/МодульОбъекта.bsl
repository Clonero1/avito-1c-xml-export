    Цены = ПолучитьЦеныКинезис(Остатки, Параметры);
    ДанныеXML = ПрочитатьТекущийXML(Параметры.ПутьКТекущемуXML);
    ДанныеСопоставления = СопоставитьXMLИНоменклатуру(ДанныеXML, Остатки, Параметры);

    // TODO: добавить обновление фото после выбора способа выгрузки на сервер.
    НовыйXML = СформироватьНовыйXML(ДанныеСопоставления, Параметры);
    Результат.Вставить("XML", НовыйXML);

    СформироватьОтчёты(Результат, Параметры);

    Возврат Результат;

