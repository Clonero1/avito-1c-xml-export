// Черновики запросов для ERP 2.5.25.101.
// Важно: точные имена регистров, измерений и реквизитов нужно проверить в конфигураторе
// конкретной базы. Файл фиксирует ожидаемые поля и направление реализации, но не является
// гарантированно готовым кодом для любой ERP 2.5.

Функция ТекстЗапросаОстатковПоСкладам() Экспорт

    // Цель: получить фактический доступный остаток по выбранным складам.
    //
    // Параметры:
    // - &ДатаОстатков
    // - &Склады
    //
    // Ожидаемые поля результата:
    // - Номенклатура
    // - Код1С
    // - Артикул
    // - КатНомер2
    // - Наименование
    // - ВидНоменклатуры
    // - Производитель
    // - Склад
    // - Остаток
    //
    // TODO: проверить фактический источник остатка:
    // - РегистрНакопления.ТоварыНаСкладах.Остатки
    // - РегистрНакопления.СвободныеОстатки.Остатки
    // - специализированные регистры складского учёта ERP.

    Возврат
    "ВЫБРАТЬ
    |   Остатки.Номенклатура КАК Номенклатура,
    |   Остатки.Номенклатура.Код КАК Код1С,
    |   Остатки.Номенклатура.Артикул КАК Артикул,
    |   Остатки.Номенклатура.Наименование КАК Наименование,
    |   Остатки.Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
    |   Остатки.Номенклатура.Производитель КАК Производитель,
    |   Остатки.Склад КАК Склад,
    |   СУММА(Остатки.КоличествоОстаток) КАК Остаток
    |ИЗ
    |   РегистрНакопления.ТоварыНаСкладах.Остатки(&ДатаОстатков, Склад В (&Склады)) КАК Остатки
    |СГРУППИРОВАТЬ ПО
    |   Остатки.Номенклатура,
    |   Остатки.Номенклатура.Код,
    |   Остатки.Номенклатура.Артикул,
    |   Остатки.Номенклатура.Наименование,
    |   Остатки.Номенклатура.ВидНоменклатуры,
    |   Остатки.Номенклатура.Производитель,
    |   Остатки.Склад
    |ИМЕЮЩИЕ
    |   СУММА(Остатки.КоличествоОстаток) > 0";

    // TODO: поле КатНомер2 часто хранится как дополнительный реквизит. Его нужно
    // присоединить отдельным запросом или временной таблицей дополнительных реквизитов.

КонецФункции

Функция ТекстЗапросаЦенКинезис() Экспорт

    // Цель: получить цену по типу цен "Кинезис".
    //
    // Параметры:
    // - &ДатаЦен
    // - &ТипЦенКинезис
    // - &Номенклатура
    //
    // Если цена не найдена, цена в XML не обновляется молча, а товар попадает в report_errors.csv.
    //
    // TODO: проверить фактический регистр цен:
    // - РегистрСведений.ЦеныНоменклатуры.СрезПоследних
    // - регистры соглашений / прайс-листов ERP.

    Возврат
    "ВЫБРАТЬ
    |   Цены.Номенклатура КАК Номенклатура,
    |   Цены.ВидЦены КАК ТипЦен,
    |   Цены.Цена КАК Цена
    |ИЗ
    |   РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
    |       &ДатаЦен,
    |       ВидЦены = &ТипЦенКинезис
    |   ) КАК Цены
    |ГДЕ
    |   Цены.Номенклатура В (&Номенклатура)";

КонецФункции

Функция ТекстЗапросаДополнительныхРеквизитовНоменклатуры() Экспорт

    // Цель: получить Avito_ID и дополнительные каталожные номера, если они есть.
    //
    // Параметры:
    // - &Номенклатура
    // - &ИменаРеквизитов
    //
    // Ожидаемые реквизиты:
    // - Avito_ID
    // - Кат. номер2 / КатНомер2
    // - OEM
    // - дополнительные поля Авито при необходимости.
    //
    // TODO: проверить хранение дополнительных реквизитов в ERP:
    // - РегистрСведений.ДополнительныеСведения
    // - РегистрСведений.ЗначенияСвойствОбъектов
    // - подсистема БСП "Свойства".

    Возврат
    "ВЫБРАТЬ
    |   ДопРеквизиты.Объект КАК Номенклатура,
    |   ДопРеквизиты.Свойство.Наименование КАК ИмяРеквизита,
    |   ДопРеквизиты.Значение КАК Значение
    |ИЗ
    |   РегистрСведений.ДополнительныеСведения КАК ДопРеквизиты
    |ГДЕ
    |   ДопРеквизиты.Объект В (&Номенклатура)
    |   И ДопРеквизиты.Свойство.Наименование В (&ИменаРеквизитов)";

КонецФункции

Функция ТекстЗапросаПрисоединенныхФайловНоменклатуры() Экспорт

    // Цель: получить присоединённые файлы номенклатуры для ZIP-фото Авито.
    //
    // Параметры:
    // - &Номенклатура
    //
    // Отбор расширений .jpg, .jpeg, .png можно сделать в запросе или после запроса в BSL.
    // В ZIP файлы должны попадать в корень архива, без вложенной папки.
    //
    // TODO: проверить фактический справочник файлов:
    // - Справочник.НоменклатураПрисоединенныеФайлы
    // - Справочник.Файлы
    // - механизмы БСП "Работа с файлами".

    Возврат
    "ВЫБРАТЬ
    |   Файлы.ВладелецФайла КАК Номенклатура,
    |   Файлы.Ссылка КАК Файл,
    |   Файлы.Наименование КАК НаименованиеФайла,
    |   Файлы.Расширение КАК Расширение,
    |   Файлы.Размер КАК Размер
    |ИЗ
    |   Справочник.НоменклатураПрисоединенныеФайлы КАК Файлы
    |ГДЕ
    |   Файлы.ВладелецФайла В (&Номенклатура)";

КонецФункции

Функция ТекстЗапросаСкладовПоНаименованию() Экспорт

    // Вспомогательный запрос для первичного заполнения списка складов формы по именам из ТЗ.
    // Лучше заменить на явный выбор ссылок складов пользователем.

    Возврат
    "ВЫБРАТЬ
    |   Склады.Ссылка КАК Склад,
    |   Склады.Наименование КАК Наименование
    |ИЗ
    |   Справочник.Склады КАК Склады
    |ГДЕ
    |   Склады.Наименование В (&НаименованияСкладов)";

КонецФункции
